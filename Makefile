sub-Plugins-PluginParam-debug_ordered:
	@if not exist Plugins\PluginParam\ mkdir Plugins\PluginParam\ & if not exist Plugins\PluginParam\ exit 1
	@set MAKEFLAGS=$(MAKEFLAGS)
	cd Plugins\PluginParam\ && ( if not exist Makefile $(QMAKE) -o Makefile D:\FilmTear\Plugins\PluginParam\PluginParam.pro -spec win32-msvc "CONFIG+=qtquickcompiler" ) && $(MAKE) -f Makefile debug
